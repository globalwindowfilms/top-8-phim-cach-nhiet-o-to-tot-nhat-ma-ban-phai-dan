<!DOCTYPE html>
<html lang="vi" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Top 8 Phim Cách Nhiệt Ô Tô Tốt Nhất - Đánh Giá & So Sánh Chi Tiết</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- AlpineJS for Interactive UI -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#fffbeb',
                            100: '#fef3c7',
                            500: '#f59e0b', // Amber
                            600: '#d97706',
                            900: '#78350f',
                        },
                        darkbg: {
                            primary: '#0B0F17',
                            secondary: '#151C2C',
                            tertiary: '#1E293B'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        [x-cloak] { display: none !important; }
        .glass-panel {
            background: rgba(21, 28, 44, 0.75);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
        .glow-amber {
            box-shadow: 0 0 20px rgba(245, 158, 11, 0.15);
        }
        .glow-amber-strong {
            box-shadow: 0 0 35px rgba(245, 158, 11, 0.35);
        }
    </style>
</head>
<body class="bg-darkbg-primary text-slate-100 font-sans min-h-screen selection:bg-brand-500 selection:text-darkbg-primary" x-data="appState()">

    <!-- Top Source Alert/Badge -->
    <div class="bg-gradient-to-r from-brand-600 via-brand-500 to-amber-700 text-darkbg-primary text-center py-2 px-4 text-xs md:text-sm font-bold tracking-wide shadow-md">
        <i class="fa-solid fa-square-arrow-up-right mr-1.5 animate-pulse"></i>
        Bài viết được tổng hợp từ nguồn chính thức của 
        <a href="https://www.globalwindowfilms.com.vn/post/top-8-phim-cach-nhiet-o-to-tot-nhat-ma-ban-phai-dan" target="_blank" class="underline hover:text-white transition duration-200">
            Global Window Films Việt Nam <i class="fa-solid fa-arrow-up-right-from-square text-xs ml-0.5"></i>
        </a>
    </div>

    <!-- Header / Navigation -->
    <header class="sticky top-0 z-50 glass-panel border-b border-slate-800 transition-all duration-300">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <!-- Logo area simulating the share hub -->
            <a href="#" class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-brand-600 to-amber-400 flex items-center justify-center text-darkbg-primary shadow-lg shadow-brand-500/20">
                    <i class="fa-solid fa-shield-halved text-xl"></i>
                </div>
                <div>
                    <span class="text-lg font-extrabold tracking-tight bg-gradient-to-r from-white via-slate-200 to-brand-500 bg-clip-text text-transparent">AUTO-INSIGHTS</span>
                    <span class="block text-[10px] text-slate-400 font-medium tracking-widest uppercase">Car Care Curated Hub</span>
                </div>
            </a>

            <!-- Source Link Button -->
            <a href="https://www.globalwindowfilms.com.vn/post/top-8-phim-cach-nhiet-o-to-tot-nhat-ma-ban-phai-dan" target="_blank" 
               class="hidden md:inline-flex items-center gap-2 px-4 py-2 bg-slate-800 hover:bg-slate-700 border border-slate-700 hover:border-slate-600 text-slate-200 text-sm font-semibold rounded-lg transition duration-200 group">
                <i class="fa-solid fa-newspaper text-brand-500 group-hover:scale-110 transition duration-200"></i>
                <span>Xem bài gốc tại Global Window Films</span>
                <i class="fa-solid fa-angle-right text-xs text-slate-400 group-hover:translate-x-0.5 transition duration-200"></i>
            </a>

            <div class="md:hidden">
                <a href="https://www.globalwindowfilms.com.vn/post/top-8-phim-cach-nhiet-o-to-tot-nhat-ma-ban-phai-dan" target="_blank" class="text-brand-500 hover:text-brand-600 text-xl">
                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                </a>
            </div>
        </div>
    </header>

    <!-- Hero Section -->
    <section class="relative py-16 md:py-24 overflow-hidden border-b border-slate-800/80 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-slate-900/40 via-darkbg-primary to-darkbg-primary">
        <!-- Abstract glowing elements -->
        <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-brand-500/5 rounded-full blur-3xl pointer-events-none"></div>
        
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
            <!-- Article Category Tag -->
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-brand-500/10 border border-brand-500/20 text-brand-500 text-xs font-semibold uppercase tracking-wider mb-6">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-500 animate-pulse"></span>
                Review &amp; Chia sẻ Kiến Thức Ô Tô
            </div>

            <h1 class="text-3xl md:text-5xl lg:text-6xl font-extrabold tracking-tight leading-tight max-w-4xl mx-auto text-white">
                Top 8 Thương Hiệu <span class="bg-gradient-to-r from-brand-400 to-amber-500 bg-clip-text text-transparent">Phim Cách Nhiệt Ô Tô</span> Tốt Nhất Hiện Nay
            </h1>

            <p class="mt-6 text-base md:text-xl text-slate-400 max-w-2xl mx-auto leading-relaxed">
                Được chọn lọc và đánh giá chi tiết dựa trên các thông số cản nhiệt thực tế, độ bền và mức độ tương thích tín hiệu cho các dòng xe hiện đại tại Việt Nam.
            </p>

            <!-- Source Citation Badge -->
            <div class="mt-8 inline-flex flex-col sm:flex-row items-center gap-3 px-6 py-4 rounded-xl bg-slate-900/90 border border-slate-800/80 max-w-xl mx-auto text-left glow-amber">
                <div class="flex-shrink-0 w-12 h-12 rounded-lg bg-brand-500/10 flex items-center justify-center text-brand-500 border border-brand-500/20">
                    <i class="fa-solid fa-quote-left text-lg"></i>
                </div>
                <div>
                    <p class="text-xs text-slate-400 font-medium">Trích nguồn bài phân tích của:</p>
                    <p class="text-sm font-semibold text-white">Global Window Films Việt Nam</p>
                    <p class="text-[11px] text-slate-500 mt-0.5 italic max-w-sm truncate">
                        Bài viết gốc: "Top 8 phim cách nhiệt ô tô tốt nhất mà bạn phải dán"
                    </p>
                </div>
                <a href="https://www.globalwindowfilms.com.vn/post/top-8-phim-cach-nhiet-o-to-tot-nhat-ma-ban-phai-dan" target="_blank" 
                   class="sm:ml-auto w-full sm:w-auto text-center px-3 py-1.5 bg-brand-500 hover:bg-brand-600 text-darkbg-primary font-bold text-xs rounded-lg transition duration-200">
                    Đọc Bài Gốc <i class="fa-solid fa-chevron-right ml-1 text-[10px]"></i>
                </a>
            </div>
        </div>
    </section>

    <!-- Main Content Area with Filters & Grid -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
        
        <!-- Quick Insight Stats Section -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-16">
            <div class="p-5 rounded-2xl bg-darkbg-secondary border border-slate-800/60">
                <span class="block text-xs text-slate-400 uppercase tracking-wider font-semibold mb-1">Mức cản UV trung bình</span>
                <span class="text-2xl md:text-3xl font-extrabold text-white">99% - 99.9%</span>
                <span class="block text-xs text-emerald-400 mt-1.5"><i class="fa-solid fa-circle-check mr-1"></i>Bảo vệ da tuyệt đối</span>
            </div>
            <div class="p-5 rounded-2xl bg-darkbg-secondary border border-slate-800/60">
                <span class="block text-xs text-slate-400 uppercase tracking-wider font-semibold mb-1">Công nghệ thịnh hành</span>
                <span class="text-2xl md:text-3xl font-extrabold text-white">Nano Ceramic</span>
                <span class="block text-xs text-brand-500 mt-1.5"><i class="fa-solid fa-wifi mr-1"></i>Không cản sóng VETC/ePass</span>
            </div>
            <div class="p-5 rounded-2xl bg-darkbg-secondary border border-slate-800/60">
                <span class="block text-xs text-slate-400 uppercase tracking-wider font-semibold mb-1">Thời hạn bảo hành</span>
                <span class="text-2xl md:text-3xl font-extrabold text-white">10 Năm - Trọn Đời</span>
                <span class="block text-xs text-slate-400 mt-1.5"><i class="fa-solid fa-shield mr-1"></i>Cam kết độ bền bỉ</span>
            </div>
            <div class="p-5 rounded-2xl bg-darkbg-secondary border border-slate-800/60">
                <span class="block text-xs text-slate-400 uppercase tracking-wider font-semibold mb-1">Tổng cản nhiệt (TSER)</span>
                <span class="text-2xl md:text-3xl font-extrabold text-white">Lên tới 75%</span>
                <span class="block text-xs text-brand-500 mt-1.5"><i class="fa-solid fa-temperature-arrow-down mr-1"></i>Hạ nhiệt sâu cho cabin</span>
            </div>
        </div>

        <!-- Interactive Film Finder Tool (Widget) -->
        <div class="mb-16 bg-gradient-to-r from-slate-900 via-darkbg-secondary to-slate-900 rounded-3xl border border-slate-800 p-6 md:p-8 relative overflow-hidden">
            <div class="absolute top-0 right-0 w-64 h-64 bg-brand-500/5 rounded-full blur-2xl pointer-events-none"></div>
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center relative z-10">
                <div class="lg:col-span-5">
                    <span class="text-brand-500 text-xs font-bold uppercase tracking-wider block mb-1">Công Cụ Đề Xuất Nhanh</span>
                    <h2 class="text-xl md:text-2xl font-bold text-white mb-3">Tìm phim cách nhiệt phù hợp với xe của bạn?</h2>
                    <p class="text-slate-400 text-sm leading-relaxed mb-4">
                        Chỉ cần chọn kiểu dáng xe và nhu cầu ưu tiên nhất của bạn, thuật toán sẽ gợi ý thương hiệu tối ưu nhất trong danh sách Top 8 này.
                    </p>
                    <div class="border-t border-slate-800 pt-4 flex items-center gap-2">
                        <i class="fa-solid fa-lightbulb text-amber-500 text-lg"></i>
                        <span class="text-xs text-slate-400">Trải nghiệm tương tác nhanh để rút ngắn thời gian tìm hiểu.</span>
                    </div>
                </div>
                <div class="lg:col-span-7 bg-darkbg-primary/90 p-6 rounded-2xl border border-slate-800/80">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs text-slate-400 font-bold mb-2 uppercase">1. Chọn phân khúc xe</label>
                            <select x-model="calculator.carType" class="w-full bg-slate-900 border border-slate-800 rounded-lg py-2.5 px-3 text-sm text-slate-200 focus:outline-none focus:border-brand-500">
                                <option value="sedan">Sedan (4-5 Chỗ)</option>
                                <option value="suv">SUV / Crossover (5-7 Chỗ)</option>
                                <option value="luxury">Xe Hạng Sang / Siêu Xe</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs text-slate-400 font-bold mb-2 uppercase">2. Nhu cầu ưu tiên cao nhất</label>
                            <select x-model="calculator.priority" class="w-full bg-slate-900 border border-slate-800 rounded-lg py-2.5 px-3 text-sm text-slate-200 focus:outline-none focus:border-brand-500">
                                <option value="heat">Cản nhiệt tối đa & Chống UV</option>
                                <option value="clear">Kính lái trong suốt & Không nhiễu sóng</option>
                                <option value="budget">Tiết kiệm chi phí & Bền bỉ</option>
                            </select>
                        </div>
                    </div>

                    <!-- Dynamic Recommendation Box -->
                    <div class="mt-6 p-4 rounded-xl bg-brand-500/5 border border-brand-500/20 flex flex-col sm:flex-row items-center gap-4 justify-between">
                        <div>
                            <span class="text-[10px] text-brand-500 font-bold uppercase tracking-widest block">Gợi ý dành cho bạn:</span>
                            <span class="text-base font-bold text-white mt-1 block" x-text="getRecommendationName()"></span>
                            <span class="text-xs text-slate-400" x-text="getRecommendationDesc()"></span>
                        </div>
                        <button @click="scrollToCard(getRecommendationId())" class="w-full sm:w-auto px-4 py-2 bg-brand-500 hover:bg-brand-600 text-darkbg-primary font-bold text-xs rounded-lg transition duration-200 shrink-0">
                            Xem Ngay <i class="fa-solid fa-arrow-down ml-1"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filter Bar & Search -->
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 mb-10 pb-6 border-b border-slate-800">
            <div>
                <h2 class="text-2xl font-bold text-white tracking-tight">Danh Sách Top 8 Thương Hiệu</h2>
                <p class="text-xs md:text-sm text-slate-400 mt-1">Sử dụng bộ lọc bên cạnh để so sánh và lựa chọn nhanh hơn.</p>
            </div>
            
            <div class="w-full md:w-auto flex flex-wrap gap-2 items-center">
                <!-- Search input -->
                <div class="relative w-full sm:w-48 md:w-60 lg:w-72">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-slate-400 text-xs">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </span>
                    <input type="text" x-model="filters.search" placeholder="Tìm tên phim..." 
                           class="w-full bg-darkbg-secondary border border-slate-800 rounded-lg py-2 pl-9 pr-4 text-xs text-slate-200 placeholder-slate-500 focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500 transition duration-150" />
                </div>

                <!-- Origin Select -->
                <select x-model="filters.origin" class="bg-darkbg-secondary border border-slate-800 text-slate-300 text-xs rounded-lg py-2 px-3 focus:outline-none focus:border-brand-500">
                    <option value="all">Mọi Xuất xứ</option>
                    <option value="Mỹ">Mỹ (USA)</option>
                    <option value="Hàn Quốc">Hàn Quốc</option>
                    <option value="Singapore">Singapore</option>
                </select>

                <!-- Segment Select -->
                <select x-model="filters.segment" class="bg-darkbg-secondary border border-slate-800 text-slate-300 text-xs rounded-lg py-2 px-3 focus:outline-none focus:border-brand-500">
                    <option value="all">Mọi Phân khúc</option>
                    <option value="Premium">Cao Cấp</option>
                    <option value="Mid-range">Tầm Trung</option>
                    <option value="Budget">Tiết Kiệm</option>
                </select>
            </div>
        </div>

        <!-- Grid of Top 8 Films -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <template x-for="(film, index) in filteredFilms()" :key="film.id">
                <div :id="film.id" class="group flex flex-col bg-darkbg-secondary rounded-2xl border border-slate-800 hover:border-slate-700/80 transition-all duration-300 overflow-hidden relative"
                     :class="film.featured ? 'ring-2 ring-brand-500/50 glow-amber' : ''">
                    
                    <!-- Featured/Highlighted badge -->
                    <div x-show="film.featured" class="absolute top-4 right-4 bg-gradient-to-r from-brand-600 to-amber-500 text-darkbg-primary font-bold text-[10px] px-2.5 py-1 rounded-md z-10 uppercase tracking-widest">
                        <i class="fa-solid fa-crown mr-1"></i>Đánh giá cao nhất
                    </div>

                    <!-- Header Content of Card -->
                    <div class="p-6 pb-0">
                        <div class="flex items-center justify-between mb-4">
                            <span class="text-[10px] uppercase font-extrabold tracking-widest px-2.5 py-1 rounded bg-slate-800 text-slate-400 border border-slate-700/50" x-text="film.origin"></span>
                            <span class="text-xs font-semibold text-brand-500" x-text="film.segmentLabel"></span>
                        </div>
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-lg flex items-center justify-center font-black text-lg bg-slate-800 text-brand-500 border border-slate-700/50" x-text="index + 1"></div>
                            <div>
                                <h3 class="text-xl font-bold text-white group-hover:text-brand-500 transition duration-200" x-text="film.name"></h3>
                                <p class="text-xs text-slate-400 mt-0.5" x-text="film.tech"></p>
                            </div>
                        </div>
                    </div>

                    <!-- Description and key specs -->
                    <div class="p-6 flex-grow flex flex-col justify-between">
                        <p class="text-xs md:text-sm text-slate-400 leading-relaxed mb-6" x-text="film.desc"></p>

                        <!-- Specifications Visual Bar -->
                        <div class="space-y-3 bg-slate-900/50 p-4 rounded-xl border border-slate-800/80 mb-6">
                            <!-- Spec 1: Heat Rejection (TSER) -->
                            <div>
                                <div class="flex justify-between text-[11px] font-semibold text-slate-300 mb-1">
                                    <span>Tổng Cản Nhiệt (TSER)</span>
                                    <span class="text-brand-500" x-text="film.specs.tser + '%'"></span>
                                </div>
                                <div class="w-full bg-slate-800 h-1.5 rounded-full overflow-hidden">
                                    <div class="bg-brand-500 h-full rounded-full transition-all duration-500" :style="'width: ' + film.specs.tser + '%'"></div>
                                </div>
                            </div>
                            <!-- Spec 2: UV Block (UVR) -->
                            <div>
                                <div class="flex justify-between text-[11px] font-semibold text-slate-300 mb-1">
                                    <span>Cản Tia Cực Tím (UVR)</span>
                                    <span class="text-brand-500" x-text="film.specs.uvr + '%'"></span>
                                </div>
                                <div class="w-full bg-slate-800 h-1.5 rounded-full overflow-hidden">
                                    <div class="bg-emerald-500 h-full rounded-full transition-all duration-500" :style="'width: ' + (film.specs.uvr > 100 ? 100 : film.specs.uvr) + '%'"></div>
                                </div>
                            </div>
                            <!-- Spec 3: Warranty -->
                            <div class="flex items-center justify-between text-[11px] font-semibold text-slate-400 pt-1 border-t border-slate-800">
                                <span>Thời Hạn Bảo Hành</span>
                                <span class="text-slate-200" x-text="film.specs.warranty"></span>
                            </div>
                        </div>

                        <!-- Highlights list -->
                        <div class="mb-6">
                            <span class="text-[10px] text-slate-400 uppercase tracking-widest font-bold block mb-2">Ưu điểm nổi bật:</span>
                            <ul class="space-y-1.5">
                                <template x-for="item in film.pros" :key="item">
                                    <li class="flex items-start text-xs text-slate-300">
                                        <i class="fa-solid fa-circle-check text-brand-500 text-[10px] mt-1 mr-2 shrink-0"></i>
                                        <span x-text="item"></span>
                                    </li>
                                </template>
                            </ul>
                        </div>

                        <!-- Card CTA: Modal details -->
                        <button @click="openFilmModal(film)" class="w-full py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-bold rounded-lg border border-slate-700/60 hover:border-slate-600 transition duration-200 flex items-center justify-center gap-1.5">
                            <span>Xem chi tiết thông số &amp; Giá</span>
                            <i class="fa-solid fa-arrow-right-long text-[10px]"></i>
                        </button>
                    </div>
                </div>
            </template>
        </div>

        <!-- No Results fallback -->
        <div x-show="filteredFilms().length === 0" class="text-center py-20 bg-darkbg-secondary rounded-3xl border border-slate-800/80">
            <i class="fa-regular fa-folder-open text-brand-500 text-5xl mb-4"></i>
            <h3 class="text-xl font-bold text-white mb-1">Không tìm thấy sản phẩm phù hợp</h3>
            <p class="text-slate-400 text-sm max-w-sm mx-auto">Vui lòng điều chỉnh lại công cụ lọc hoặc dọn sạch ô tìm kiếm để hiển thị lại danh sách.</p>
            <button @click="resetFilters()" class="mt-4 px-4 py-2 bg-brand-500 text-darkbg-primary text-xs font-bold rounded-lg">Khôi Phục Bộ Lọc</button>
        </div>
    </main>

    <!-- Deep Dive: Key Selection Metrics explanation -->
    <section class="bg-darkbg-secondary py-16 border-t border-b border-slate-800/80">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-12">
                <span class="text-brand-500 text-xs font-bold uppercase tracking-wider block mb-1">Kinh Nghiệm Thực Tế</span>
                <h2 class="text-2xl md:text-3xl font-bold text-white">Lưu Ý Quan Trọng Khi Chọn Phim Cách Nhiệt</h2>
                <p class="text-slate-400 text-sm max-w-xl mx-auto mt-2">Đừng chỉ nhìn vào giá tiền, hãy xem xét các yếu tố kỹ thuật thực sự quyết định trải nghiệm lái xe.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div class="p-6 bg-slate-900/60 rounded-2xl border border-slate-800">
                    <div class="w-10 h-10 rounded-lg bg-red-500/10 text-red-400 flex items-center justify-center mb-4 border border-red-500/20">
                        <i class="fa-solid fa-signal-radiation"></i>
                    </div>
