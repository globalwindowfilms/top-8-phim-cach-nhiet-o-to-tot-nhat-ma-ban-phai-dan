                            'Tương thích sóng tốt, bảo vệ nội thất an toàn'
                        ],
                        cons: [
                            'Không có tính năng chống trầy vượt trội như phân khúc Mỹ cao cấp'
                        ],
                        editorialAdvice: 'Nếu bạn có ngân sách vừa phải nhưng không thích phim giá rẻ, CeraMAX là mảnh ghép tuyệt đối vừa vặn cho xe cá nhân gia đình.'
                    }
                ],

                filteredFilms() {
                    return this.films.filter(film => {
                        // Search Filter
                        const matchesSearch = film.name.toLowerCase().includes(this.filters.search.toLowerCase()) || 
                                              film.tech.toLowerCase().includes(this.filters.search.toLowerCase());
                        
                        // Origin Filter
                        const matchesOrigin = this.filters.origin === 'all' || film.origin === this.filters.origin;
                        
                        // Segment Filter
                        const matchesSegment = this.filters.segment === 'all' || film.segment === this.filters.segment;

                        return matchesSearch && matchesOrigin && matchesSegment;
                    });
                },

                getRecommendationName() {
                    if (this.calculator.carType === 'luxury' || this.calculator.priority === 'heat') {
                        return "Global Premium / 3M Crystalline";
                    } else if (this.calculator.priority === 'clear') {
                        return "Global Nano-Ceramic (Siêu co liên kết chéo)";
                    } else {
                        return "CeraMAX Hàn Quốc / Ntech";
                    }
                },

                getRecommendationDesc() {
                    if (this.calculator.carType === 'luxury' || this.calculator.priority === 'heat') {
                        return "Sự lựa chọn cản nhiệt hàng đầu thế giới giúp giữ không gian nội thất xa xỉ luôn được bảo quản mát mẻ.";
                    } else if (this.calculator.priority === 'clear') {
                        return "Tuyệt hảo cho kính lái không chứa hạt kim loại, tương thích 100% với các thiết bị định vị và thẻ qua trạm VETC.";
                    } else {
                        return "Cân đối chi phí tối ưu, thích hợp cho các xe dịch vụ hoặc nhu cầu gia đình cơ bản cần cản nhiệt tốt.";
                    }
                },

                getRecommendationId() {
                    if (this.calculator.carType === 'luxury' || this.calculator.priority === 'heat') {
                        return "global-window-films";
                    } else if (this.calculator.priority === 'clear') {
                        return "global-window-films";
                    } else {
                        return "ceramax";
                    }
                },

                scrollToCard(id) {
                    const el = document.getElementById(id);
                    if (el) {
                        el.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        // Add temporary highlighting effect
                        el.classList.add('glow-amber-strong');
                        setTimeout(() => {
                            el.classList.remove('glow-amber-strong');
                        }, 2000);
                    }
                },

                resetFilters() {
                    this.filters.search = '';
                    this.filters.origin = 'all';
                    this.filters.segment = 'all';
                },

                openFilmModal(film) {
                    this.modal.data = film;
                    this.modal.isOpen = true;
                },

                closeModal() {
                    this.modal.isOpen = false;
                    this.modal.data = {};
                }
            }
        }
    </script>
</body>
</html>
